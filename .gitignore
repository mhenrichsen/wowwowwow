# --- secrets -------------------------------------------------------------
# The web page's access key. Anything holding it can read the status page,
# and with --control can start and stop the bot.
web_key.txt
phone_link.txt

# --- live run state ------------------------------------------------------
# Rewritten every few seconds by a running bot; never worth a commit.
status.json
last_death.json
bot.lock
bot.pid
STOP
STOP_SAFE
bot.log
logs/
_backups/

# --- generated caches ----------------------------------------------------
# Derived from the mmaps and the world DB. Large, machine-specific and
# rebuilt on demand.
data/*.pkl
data/road_pts_*.json
data/npcs.json
data/quest_progress_*.json
__pycache__/
*.pyc

# --- big binaries --------------------------------------------------------
# 55 MB vendor binary; download it again rather than carry it in history.
cloudflared.exe

# --- screenshots ---------------------------------------------------------
probe_shots/
*.png

